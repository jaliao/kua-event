# ----------------------------------------------
# 環境變數範例 — 複製為 .env 後填入實際值
# ----------------------------------------------

# PostgreSQL 連線字串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kau_event?schema=public"

# NextAuth（後台管理員 Google OAuth 登入）
# 產生密鑰：openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 應用程式網址
# 正式：https://event.kuaglobal.org　測試：https://kua-event.blockcode.com.tw
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
