# ----------------------------------------------
# 環境變數範例 — 複製為 .env 後填入實際值
# ----------------------------------------------

# === 資料庫 ===
# Next.js / Prisma 執行期連線（prisma.config.ts 與 lib/prisma.ts 讀此變數）
# 本機直接開發用 localhost；以 make dev 在容器內跑時請改 host 為 db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kau_event?schema=public"
# Makefile 本機 Prisma 命令使用（連 Docker 對外埠 localhost:5432）
DATABASE_URL_DEV="postgresql://postgres:postgres@localhost:5432/kau_event?schema=public"
# 遠端 VPS3 部署（需先 make tunnel-vps3 開 SSH tunnel，localhost:15432）
DATABASE_URL_VPS3="postgresql://postgres:postgres@localhost:15432/kau_event?schema=public"

# === Docker / Postgres 容器（docker-compose 與 Makefile 使用）===
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="kau_event"
# 容器 volume 權限（docker compose 直接啟動時對齊本機使用者；make dev 會自動帶入）
UID="1000"
GID="1000"
# Cloudflare Tunnel token（docker-compose.dev.yml 的 cloudflared 服務，選填）
CF_TUNNEL_TOKEN=""

# === NextAuth（後台管理員 Google OAuth 登入）===
# 產生密鑰：openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# === 應用程式網址 ===
# 正式：https://event.kuaglobal.org　測試：https://kua-event.blockcode.com.tw
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
